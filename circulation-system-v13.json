  "texts": {
    "heart": {
      "systole": {
        "title": "心室收縮期 (Systole)",
        "desc": "心室肌肉強烈收縮，體積變小、內部壓力急劇升高，迫使血液強力擠入動脈。此時房室瓣關閉（發出第一心音，防止血液逆流回心房），半月瓣開啟讓血液送出。",
        "color": "text-red-400"
      },
      "diastole": {
        "title": "心室舒張期 (Diastole)",
        "desc": "心室肌肉放鬆，體積變大、壓力降低，形成吸力讓心房的血液流入充盈心室。此時半月瓣關閉（發出第二心音，防止動脈血逆流），房室瓣開啟。",
        "color": "text-blue-400"
      }
    },
    "organs": {
      "肺臟": "【氣體交換樞紐】缺氧血在此釋放二氧化碳，並結合氧氣。轉換為鮮紅的充氧血流回左心房。",
      "胃": "【強力研磨機】消耗大量氧氣與ATP進行物理研磨與化學消化（胃酸）。吸收少部分水分與酒精後，滿載物資的缺氧血會送入「肝門靜脈」。",
      "肝臟": "【海關與解毒中心】接收肝動脈的氧氣與「肝門靜脈」的物資。遇到養分轉肝醣，遇毒素進行解毒，安檢完畢才放行至全身。",
      "肝門靜脈": "【特殊的過境通道】連接腸胃與肝臟的靜脈，不直接回心臟！將吸收的養分與潛在毒素第一時間扣送至肝臟安檢。",
      "小腸": "【主要消化與吸收區】負責絕大部分的化學消化。小腸絨毛內的微血管負責吸收水溶性養分（如葡萄糖、胺基酸），隨後匯集送入「肝門靜脈」。",
      "大腸": "【水分回收與殘渣成形】不具備消化酵素！主要負責回收食糜中剩餘的水分與電解質，並吸收腸道菌群產生的維生素。吸收的物資同樣匯流至「肝門靜脈」。",
      "胰臟": "【內外分泌雙效器官】製造消化酵素注入小腸。同時分泌胰島素、升糖素等賀爾蒙送往全身調節血糖。",
      "腎臟": "【血液淨化廠】微血管過濾血液，保留血球與蛋白質，將尿素、多餘水分與電解質排除形成尿液。",
      "一般微血管": "【物資交接站】遍佈全身組織與肌肉。卸下氧氣與葡萄糖供細胞產生能量；帶走二氧化碳與廢物。",
      "微淋巴管盲端": "【組織液回收】血漿滲出微血管成為組織液。約10%未被微血管回收的組織液，會流入末端封閉的微淋巴管，改稱為「淋巴」。(就像多餘的地下水漫流進水溝)",
      "淋巴結": "【免疫防線】淋巴管沿途的膨大構造，內部聚集大量白血球，負責吞噬病原體、過濾淋巴液。感冒時摸到的局部腫塊通常是它在發炎作戰。(就像高速公路的安檢站)",
      "淋巴管段落": "【單向推進動力】淋巴系統「沒有」心臟作為動力幫浦，管內具防止逆流的瓣膜，淋巴主要依靠人體活動時「周圍骨骼肌收縮」的擠壓來單向推進。(像腳踏式打氣筒)",
      "鎖骨下靜脈": "【體液回歸點】淋巴管在體內逐漸匯集成較大的淋巴管，最終會在左右兩側的鎖骨下方注入靜脈，讓淋巴液重新回到血液循環中。(如下水道淨化後匯流回大河)",
      "小腸乳糜管": "【會考特例考點】分布在小腸絨毛內的微淋巴管，專門吸收「脂溶性養分」。這些脂質不入微血管、不走肝門靜脈，而是直接進入淋巴系統。(專送大型包裹的VIP物流通道)"
    }
  }
}